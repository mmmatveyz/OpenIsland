                                    <Button x:Name="OpenCodeDeleteSession" Grid.Column="1" Style="{StaticResource ChipButton}" Width="26" Height="26" Padding="0" Margin="2,0,0,0" Content="&#xD7;" Click="OpenCodeDeleteSession_Click" ToolTip="Удалить текущую сессию"/>
