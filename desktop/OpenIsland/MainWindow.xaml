                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ChipButton}" Width="24" Height="24" Padding="0" Content="&lt;" Margin="0,0,8,0" Click="ShelfBack_Click" ToolTip="Назад"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="ПОЛКА ФАЙЛОВ" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ChipButton}" Height="24" Padding="10,0" Content="+ Файл" Click="ShelfAdd_Click" Margin="0,0,6,0" ToolTip="Добавить файл на полку"/>
                                    <Button Style="{StaticResource ChipButton}" Height="24" Padding="8,0" Content="Очистить" Click="ShelfClear_Click" ToolTip="Очистить всю полку"/>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                                </ScrollViewer.Resources>
                                <StackPanel x:Name="ShelfList"/>
                            </ScrollViewer>
                            <TextBlock x:Name="ShelfEmpty" Grid.Row="1" Text="Перетащите файлы на остров &#8212; они останутся на полке для быстрого доступа"
                                       FontSize="12" Foreground="{StaticResource Dim}" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="250" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ShelfCountText" Grid.Row="2" FontSize="10.5" Foreground="{StaticResource Dim}" Margin="2,4,2,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>


            <Canvas x:Name="Shared" Visibility="Collapsed" Opacity="0">
                <Grid x:Name="ArtSpot" Width="64" Height="64" MouseLeftButtonUp="Art_MouseLeftButtonUp">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ArtSize"/>
                            <TranslateTransform x:Name="ArtMove"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border Background="{StaticResource ArtPlaceholder}">
                        <local:Icon Kind="Note" Width="30" Height="30" Fill="{StaticResource Dim}"/>
                    </Border>
                    <local:Cover x:Name="Art" Radius="16"/>
                </Grid>
                <local:Equalizer x:Name="Eq" Bars="8" Few="5" Width="21" Height="16" IsHitTestVisible="False">
                    <local:Equalizer.RenderTransform>
                        <TranslateTransform x:Name="EqMove"/>
                    </local:Equalizer.RenderTransform>
                </local:Equalizer>
            </Canvas>
        </Grid>

        <Border x:Name="Bubble" Width="78" Height="34" CornerRadius="17" Visibility="Collapsed"
                Background="Transparent" Padding="1"
                HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0,0"
                MouseEnter="Bubble_MouseEnter" MouseLeave="Bubble_MouseLeave"
                MouseLeftButtonDown="Bubble_MouseLeftButtonDown" MouseLeftButtonUp="Bubble_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale"/>
                    <TranslateTransform x:Name="BubbleMove"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid x:Name="BubbleBody" ClipToBounds="True">
                <Grid x:Name="BubbleTimer" Width="76" HorizontalAlignment="Left">
                    <local:Ring x:Name="BubbleRing" Width="16" Height="16"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <local:Digits x:Name="BubbleText" Text="25:00" FontSize="12.5" FontWeight="SemiBold"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
