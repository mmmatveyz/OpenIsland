<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>OpenIsland</AssemblyName>
    <RootNamespace>OpenIsland</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <ApplicationIcon>Assets\OpenIsland.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <Product>OpenIsland</Product>
    <Company>OpenIsland</Company>
    <AssemblyTitle>OpenIsland — островок с пультом AI-агента</AssemblyTitle>
    <Description>Плавающий островок для Windows с пультом AI-агента OpenCode</Description>
    <Copyright>© 2026 OpenIsland</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.otf;Fonts\*.ttf" />
    <Resource Include="Gadgets\*.png" />
    <Resource Include="Assets\*.ico;Assets\*.mp3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Юнит-тесты (tests/OpenIsland.Tests) работают с internal-логикой: парсинг
       ответов OpenCode, история буфера обмена, нормализация версий и разбор
       changelog апдейтера. -->
  <ItemGroup>
    <InternalsVisibleTo Include="OpenIsland.Tests" />
  </ItemGroup>

</Project>
